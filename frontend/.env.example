# Used at build time for Next.js API rewrites.
# Inside Docker Compose this is set to http://nginx.
API_PROXY_URL=http://localhost:8001

# Optional public HTTPS origin students can open on their phones.
# Do NOT use localhost for phone QR scanning. Example: https://attendance.example.edu
# This variable is embedded in the frontend build; rebuild after changing it.
# NEXT_PUBLIC_STUDENT_SCAN_BASE_URL=https://attendance.example.edu
